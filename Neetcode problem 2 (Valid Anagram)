Neetcode problem 2 (Valid Anagram)

Code:
class Solution {
    public boolean isAnagram(String s, String t) {
       int a= s.length();
       int b= t.length();
       boolean x= true;

       if(a!=b){
        x=false;
        return x;
       }
       else{
       int [] freq =new int [26];

       for(int i=0, j=0; i<s.length() && j<t.length(); i++, j++){
        freq [((int) s.charAt (i))-97]++;
        freq [((int) t.charAt (j))-97]--;
       }

       for(int k=0; k<freq.length; k++){
       if(freq[k]!=0){
        x= false;
        return x;
        }
    }
    return x;
    }
    }
}



